{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/health", "destination": "/api/gateway?path=health" },
    { "source": "/v1/:path*", "destination": "/api/gateway?path=v1/:path*" },
    { "source": "/v3/:path*", "destination": "/api/gateway?path=v3/:path*" }
  ],
  "functions": {
    "api/gateway.js": { "maxDuration": 120 }
  }
}
