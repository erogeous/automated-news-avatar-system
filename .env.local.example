# Copy this file to .env.local and fill in the values locally.
# Never commit or share the real API key.
OPENIAPI_BASE_URL=https://openiapi.com/v1
OPENIAPI_API_KEY=

# Model names exposed by the aggregator.
LLM_MODEL=gpt-5.4
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
TTS_MODEL=speech-2.8-hd

# HeyGen API. A Singapore server can normally call the official endpoints directly.
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://api.heygen.com
HEYGEN_UPLOAD_BASE_URL=https://upload.heygen.com
HEYGEN_RESOLUTION=720p

# Server runtime. Keep the media process private; the web app proxies it.
PORT=3000
MEDIA_SERVICE_PORT=3101
STUDIO_DATA_DIR=/opt/news-avatar/data
STUDIO_LIBRARY_DIR=/opt/news-avatar/data/studio-library

# Public HTTPS origins reachable by Volcengine. Local paths are preserved.
PUBLIC_APP_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
