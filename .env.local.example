# Copy this file to .env.local and fill in the values locally.
# Never commit or share the real API key.
OPENIAPI_BASE_URL=https://openiapi.com/v1
OPENIAPI_API_KEY=

# Model names exposed by the aggregator.
LLM_MODEL=gpt-5.4
VOICE_CLONE_MODEL=MiniMax-Voice-Clone
TTS_MODEL=speech-2.8-hd

# HeyGen API. Use the Vercel gateway URL in production, or api.heygen.com for direct access.
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://vercel-gateway-alpha.vercel.app
HEYGEN_RESOLUTION=1080p

# Public HTTPS origins reachable by Volcengine. Local paths are preserved.
PUBLIC_APP_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
