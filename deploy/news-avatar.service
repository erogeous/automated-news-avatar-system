[Unit]
Description=News Avatar Workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newsavatar
Group=newsavatar
WorkingDirectory=/opt/news-avatar/app
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node /opt/news-avatar/app/scripts/start-production.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/news-avatar/app/.wrangler /opt/news-avatar/data

[Install]
WantedBy=multi-user.target
